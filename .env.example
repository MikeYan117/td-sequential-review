# Copy to .env (gitignored) to let `insight` and `view --llm` ask an LLM for the conclusion.
# An OpenAI-compatible Responses API: the scripts POST to ${INSIGHT_LLM_BASE_URL}/responses. Must be https.
INSIGHT_LLM_BASE_URL=
INSIGHT_LLM_API_KEY=
# Optional; the live service uses the defaults.
# INSIGHT_LLM_MODEL=gpt-6.1-sol
# INSIGHT_LLM_REASONING_EFFORT=medium
